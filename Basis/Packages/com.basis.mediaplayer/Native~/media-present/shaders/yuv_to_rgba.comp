// One-pass YCbCr -> RGBA convert (§6.8): the sampler carries the driver's
// per-buffer suggested VkSamplerYcbcrConversion, so the matrix/range work
// happens in the sampler and this shader only maps pixels. Destination
// pixels map 1:1 onto the source's display region (the Unity texture is
// display-sized; the coded surface may be larger and is cropped here).
// `flip` mirrors the sample position per axis: Unity samples an
// externally written RenderTexture vertically flipped on Vulkan (row 0
// is the on-screen bottom; pinned empirically on the Quest pass), so
// the render side sets flip.y.
//
// Regenerate yuv_to_rgba.spv with the NDK's glslc:
//   glslc -fshader-stage=comp -O -o yuv_to_rgba.spv yuv_to_rgba.comp
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src_yuv;
layout(binding = 1, rgba8) writeonly uniform image2D dst_rgba;

layout(push_constant) uniform Push {
    ivec2 dst_size;
    vec2 inv_coded_size;
    ivec2 flip;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.dst_size.x || p.y >= pc.dst_size.y) {
        return;
    }
    ivec2 sp = p;
    if (pc.flip.x != 0) {
        sp.x = pc.dst_size.x - 1 - sp.x;
    }
    if (pc.flip.y != 0) {
        sp.y = pc.dst_size.y - 1 - sp.y;
    }
    vec2 uv = (vec2(sp) + 0.5) * pc.inv_coded_size;
    vec4 c = texture(src_yuv, uv);
    imageStore(dst_rgba, p, vec4(c.rgb, 1.0));
}
